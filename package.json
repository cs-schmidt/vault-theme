{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "build": "node build --mode production",
    "build:dev": "node build --mode development --watch",
    "lint": "npm run lint:css && npm run lint:fmt-check",
    "lint:fix": "npm run lint:fmt && npm run lint:css -- --fix",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .lintignore",
    "lint:fmt": "prettier --ignore-path .lintignore --ignore-unknown --write .",
    "lint:fmt-check": "prettier --ignore-path .lintignore --ignore-unknown --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "chokidar": "^6.0.0",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "electron-to-chromium": "^1.5.485",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "joi": "^18.3.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-clean-order": "^6.1.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
