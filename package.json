{
  "private": true,
  "type": "module",
  "scripts": {
    "clean-code:check": "npm run lint:check && npm run format:check",
    "clean-code:fix": "npm run lint:fix && npm run format:fix",
    "lint:check": "stylelint \"**/*.css\" --ignore-path .toolignore",
    "lint:fix": "stylelint \"**/*.css\" --ignore-path .toolignore --fix",
    "format:check": "prettier --ignore-unknown --ignore-path .toolignore --check .",
    "format:fix": "prettier --ignore-unknown --ignore-path .toolignore --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-clean-order": "^6.1.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
